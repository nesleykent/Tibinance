# Public settings only. Nothing here may contain a key, token, password or other credential.
# Static deployments: export desired values, then run node tools/write_public_config.mjs before serving.
# Node 20+: node --env-file=.env tools/write_public_config.mjs
TIBINANCE_API_BASE_URL=https://api.tibiadata.com/v4
TIBINANCE_WORLDS_CACHE_MS=21600000
TIBINANCE_ONLINE_REFRESH_MS=300000
TIBINANCE_DOWNLOAD_REVOKE_MS=10000
TIBINANCE_ANNOUNCEMENT_DELAY_MS=700
TIBINANCE_DEFAULT_WORLD=Antica
TIBINANCE_MARKET_RANGE=1Y
TIBINANCE_ECONOMY_RANGE=All
TIBINANCE_STALE_DAYS=7
